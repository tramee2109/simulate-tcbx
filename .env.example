# ==============================================================================
# TCEX Spot BTC/VND Multi-Account Strategy Engine - Environment Variables
# Copy this file to .env on the server and edit values:
#   cp .env.example .env
# ==============================================================================

# Exchange & Session Configuration
TCEX_BASE_URL=https://simulation.the20.sg
TCEX_SESSION_KEY=dc1tpbu76rkff8gccfug
TCEX_MARKET_SYMBOL=BTC_VND

# Execution Mode: PAPER or LIVE
TCEX_EXECUTION_MODE=LIVE

# Explicit Safety Gate: Must be true to allow LIVE order submissions
TCEX_ALLOW_LIVE=true

# Engine Loop Intervals (seconds)
TCEX_TICK_INTERVAL=2.0
TCEX_SNAPSHOT_INTERVAL=1800

# Path to Account CSV file on the host (mounted securely to container)
HOST_ACCOUNT_CSV=./accounts.csv
